#!/usr/bin/env bash
# dev — orchestrate a kitty tab with nvim + shell + Claude for a project.
#
# Full docs:        docs/dev.md (alongside this script)
# Usage summary:    dev --help
# Health check:     dev check

# ── Configuration ──────────────────────────────────────────────────────────
: "${DEV_CLAUDE_BIAS:=30}"
: "${DEV_SHELL_BIAS:=30}"
: "${DEV_LOCKFILE_TIMEOUT:=5}"      # seconds
: "${DEV_SHELL_READY_WAIT:=0.3}"    # seconds; gives slow shells time to prompt
: "${DEV_SESSIONS_FILE:=$HOME/.cache/dev/sessions.json}"

# ── Help ───────────────────────────────────────────────────────────────────
_dev_help() {
  cat <<'EOF'
dev — orchestrate a kitty tab with nvim + shell + Claude for a project.

USAGE
  dev                       open default 3-pane (nvim / shell | claude)
  dev -s                    open simple 2-pane (nvim | shell), no claude
  dev .                     build the layout in the CURRENT kitty tab/cwd
  dev close [target]        close a dev session (target: omit = fzf-pick, '.' = current tab)
  dev check                 health-check the workflow prerequisites and live flow
  dev --help, dev -h        show this help

ENVIRONMENT
  DEV_CLAUDE_BIAS          claude pane width % (default 30)
  DEV_SHELL_BIAS           shell pane size %   (default 30)
  DEV_LOCKFILE_TIMEOUT     seconds to wait for nvim's IDE lockfile (default 5)
  DEV_SHELL_READY_WAIT     seconds to wait for a new shell to be ready (default 0.3)
  DEV_SESSIONS_FILE        session-state file (default ~/.cache/dev/sessions.json)
  DEV_ANY_CWD=1            allow `dev .` from cwds outside ~/Dev

EXAMPLES
  dev                       fzf-pick a project under ~/Dev, open the layout
  DEV_CLAUDE_BIAS=40 dev    same, but give Claude 40% of the tab
  cd ~/Dev/foo && dev .     convert the current tab into the layout
  dev close                 fzf-pick a running session and soft-close it
  dev close .               soft-close the current tab (if it's a dev session)
EOF
}

# ── Prerequisites ──────────────────────────────────────────────────────────
_dev_prereq() {
  local missing=0
  if ! command -v kitty >/dev/null 2>&1; then
    echo "dev: 'kitty' not found in PATH" >&2
    missing=1
  fi
  if ! command -v claude >/dev/null 2>&1; then
    echo "dev: 'claude' not found in PATH" >&2
    missing=1
  fi
  if ! command -v fzf >/dev/null 2>&1; then
    echo "dev: 'fzf' not found in PATH" >&2
    missing=1
  fi
  if ! kitty @ ls >/dev/null 2>&1; then
    echo "dev: kitty remote control not responding. In ~/.config/kitty/kitty.conf, set:" >&2
    echo "       allow_remote_control yes" >&2
    echo "       listen_on unix:/tmp/mykitty" >&2
    echo "     then fully relaunch kitty (cmd-Q)." >&2
    missing=1
  fi
  return $missing
}

# ── Lockfile helpers ───────────────────────────────────────────────────────
# Prune lockfiles whose nvim process is no longer alive.
_dev_prune_dead_lockfiles() {
  local lock pid
  shopt -s nullglob
  for lock in "$HOME"/.claude/ide/*.lock; do
    pid=""
    if command -v jq >/dev/null 2>&1; then
      pid=$(jq -r '.pid // empty' "$lock" 2>/dev/null)
    else
      # Fallback: pull "pid":N out of the JSON with sed
      pid=$(sed -n 's/.*"pid":[[:space:]]*\([0-9]\{1,\}\).*/\1/p' "$lock" 2>/dev/null | head -1)
    fi
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$lock"
    fi
  done
  shopt -u nullglob
}

# Echo all current lockfile paths, one per line.
_dev_lockfile_snapshot() {
  shopt -s nullglob
  local lock
  for lock in "$HOME"/.claude/ide/*.lock; do
    echo "$lock"
  done
  shopt -u nullglob
}

# Check whether a lockfile's workspaceFolders contains the given project path.
_dev_lockfile_matches() {
  local lock="$1" path="$2"
  if command -v jq >/dev/null 2>&1; then
    jq -e --arg p "$path" '.workspaceFolders | index($p)' "$lock" >/dev/null 2>&1
  else
    grep -F "\"$path\"" "$lock" >/dev/null 2>&1
  fi
}

# Wait up to $DEV_LOCKFILE_TIMEOUT seconds for a NEW lockfile (i.e. not in
# the $before snapshot) whose workspaceFolders matches $path. Echoes the
# matched lockfile path on success; empty on timeout.
_dev_wait_for_new_lockfile() {
  local path="$1" before="$2"
  local iterations=$((DEV_LOCKFILE_TIMEOUT * 10))
  local i lock
  shopt -s nullglob
  for ((i = 0; i < iterations; i++)); do
    for lock in "$HOME"/.claude/ide/*.lock; do
      if grep -qFx "$lock" <<<"$before"; then
        continue
      fi
      if _dev_lockfile_matches "$lock" "$path"; then
        echo "$lock"
        shopt -u nullglob
        return 0
      fi
    done
    sleep 0.1
  done
  shopt -u nullglob
  return 1
}

# ── Session state ──────────────────────────────────────────────────────────
# Args: tab_id project nvim_win claude_win shell_win
# Any of the window IDs may be empty (e.g. claude_win in simple mode).
_dev_record_session() {
  local tab_id="$1" project="$2" nvim_w="$3" claude_w="$4" shell_w="$5"
  mkdir -p "$(dirname "$DEV_SESSIONS_FILE")"
  if command -v jq >/dev/null 2>&1; then
    local tmp
    tmp=$(mktemp)
    local existing="[]"
    [[ -f "$DEV_SESSIONS_FILE" ]] && existing=$(cat "$DEV_SESSIONS_FILE")
    jq --arg tab "$tab_id" --arg proj "$project" --arg ts "$(date -u +%FT%TZ)" \
       --arg nv "$nvim_w" --arg cl "$claude_w" --arg sh "$shell_w" \
      '. + [{tab_id: $tab, project_path: $proj, started_at: $ts,
             nvim_win: $nv, claude_win: $cl, shell_win: $sh}]' \
      <<<"$existing" >"$tmp" 2>/dev/null && mv "$tmp" "$DEV_SESSIONS_FILE" || rm -f "$tmp"
  fi
}

# Drop sessions whose tab_id is no longer live in kitty. Echoes the count of
# remaining live sessions.
_dev_prune_sessions() {
  [[ -f "$DEV_SESSIONS_FILE" ]] || { echo 0; return; }
  if ! command -v jq >/dev/null 2>&1; then
    echo 0
    return
  fi
  local live tmp
  live=$(kitty @ ls 2>/dev/null | jq -c '[.[] | .tabs[].id]')
  tmp=$(mktemp)
  jq --argjson live "${live:-[]}" \
     'map(select((.tab_id | tonumber) as $t | $live | any(. == $t)))' \
     "$DEV_SESSIONS_FILE" > "$tmp" 2>/dev/null && mv "$tmp" "$DEV_SESSIONS_FILE" || rm -f "$tmp"
  jq 'length' "$DEV_SESSIONS_FILE" 2>/dev/null || echo 0
}

# ── Kitty window/tab introspection ─────────────────────────────────────────
# Echo the kitty tab id containing the given window id.
_dev_tab_id_for_window() {
  local win="$1"
  if command -v jq >/dev/null 2>&1; then
    kitty @ ls 2>/dev/null | jq -r --arg w "$win" \
      '[.[].tabs[] | select(.windows[].id == ($w|tonumber)) | .id][0] // ""'
  fi
}

# Echo the focused kitty window's id (across all os-windows).
_dev_current_window_id() {
  if command -v jq >/dev/null 2>&1; then
    kitty @ ls 2>/dev/null | jq -r \
      '[.[] | .tabs[] | select(.is_focused) | .windows[] | select(.is_focused) | .id][0] // ""'
  fi
}

# ── Health check ───────────────────────────────────────────────────────────
_dev_check() {
  local pass=0 warn=0 fail=0
  local green="" yellow="" red="" reset=""
  if [[ -t 1 ]]; then
    green=$'\033[32m'; yellow=$'\033[33m'; red=$'\033[31m'; reset=$'\033[0m'
  fi

  _row() {
    case "$1" in
      PASS) printf "  %sPASS%s  %s\n" "$green" "$reset" "$2"; pass=$((pass+1)) ;;
      WARN) printf "  %sWARN%s  %s\n" "$yellow" "$reset" "$2"; warn=$((warn+1)) ;;
      FAIL) printf "  %sFAIL%s  %s\n" "$red" "$reset" "$2"; fail=$((fail+1)) ;;
    esac
  }

  echo "dev check — prerequisites"

  # Required binaries
  command -v kitty >/dev/null 2>&1 \
    && _row PASS "kitty in PATH" \
    || _row FAIL "kitty not in PATH"

  if command -v claude >/dev/null 2>&1; then
    local cv
    cv=$(claude --version 2>/dev/null | head -1)
    _row PASS "claude in PATH${cv:+ — $cv}"
  else
    _row FAIL "claude not in PATH"
  fi

  if command -v nvim >/dev/null 2>&1; then
    local nv
    nv=$(nvim --version 2>/dev/null | head -1)
    _row PASS "nvim in PATH${nv:+ — $nv}"
  else
    _row FAIL "nvim not in PATH"
  fi

  command -v fzf >/dev/null 2>&1 \
    && _row PASS "fzf in PATH" \
    || _row FAIL "fzf not in PATH"

  if command -v jq >/dev/null 2>&1; then
    _row PASS "jq in PATH"
  else
    _row WARN "jq not in PATH (lockfile match falls back to grep; dev close requires jq)"
  fi

  # Runtime checks
  if kitty @ ls >/dev/null 2>&1; then
    _row PASS "kitty remote control responding"
  else
    _row FAIL "kitty @ ls failed — set 'allow_remote_control yes' + 'listen_on …' in kitty.conf and relaunch kitty"
  fi

  mkdir -p "$HOME/.claude/ide" 2>/dev/null
  if [[ -w "$HOME/.claude/ide" ]]; then
    _row PASS "~/.claude/ide/ writable"
  else
    _row FAIL "~/.claude/ide/ not writable"
  fi

  echo
  echo "dev check — live flow simulation"

  if (( fail > 0 )); then
    _row WARN "skipping (prerequisites failed)"
  else
    # Spawn a headless nvim in a temp cwd; claudecode.nvim (if eager-loaded)
    # writes a lockfile shortly after VeryLazy. We snapshot beforehand and
    # confirm a new matching lockfile appears within the timeout.
    local tmpdir before found="" pid
    tmpdir=$(mktemp -d)
    # Resolve symlinks (macOS /var -> /private/var); claudecode records the
    # real path in workspaceFolders, so we must compare against that.
    tmpdir=$(cd "$tmpdir" && pwd -P)
    before=$(_dev_lockfile_snapshot)

    (
      cd "$tmpdir"
      nvim --headless \
        -c "autocmd User VeryLazy ++once lua vim.defer_fn(function() vim.cmd.qa() end, 1500)" \
        >/dev/null 2>&1
    ) &
    pid=$!

    local i iterations=$((DEV_LOCKFILE_TIMEOUT * 10))
    shopt -s nullglob
    for ((i = 0; i < iterations; i++)); do
      for lock in "$HOME"/.claude/ide/*.lock; do
        if grep -qFx "$lock" <<<"$before"; then
          continue
        fi
        if _dev_lockfile_matches "$lock" "$tmpdir"; then
          found="$lock"
          break 2
        fi
      done
      sleep 0.1
    done
    shopt -u nullglob

    if [[ -n "$found" ]]; then
      local port
      port=$(basename "$found" .lock)
      _row PASS "headless nvim wrote IDE lockfile (port=$port)"
    else
      _row FAIL "headless nvim didn't write IDE lockfile within ${DEV_LOCKFILE_TIMEOUT}s — is claudecode.nvim eager-loaded?"
    fi

    wait "$pid" 2>/dev/null
    rm -rf "$tmpdir"
  fi

  echo
  if (( fail > 0 )); then
    printf "%d PASS, %d WARN, %s%d FAIL%s\n" "$pass" "$warn" "$red" "$fail" "$reset"
    return 1
  fi
  printf "%d PASS, %d WARN, 0 FAIL\n" "$pass" "$warn"
  return 0
}

# ── Soft-close a session ───────────────────────────────────────────────────
_dev_close() {
  _dev_prereq || return 1
  if ! command -v jq >/dev/null 2>&1; then
    echo "dev close: requires jq" >&2
    return 1
  fi

  local target="${1:-}"
  if [[ -n "$target" && "$target" != "." ]]; then
    echo "dev close: unrecognized target '$target' (expected '.' or no argument)." >&2
    return 1
  fi

  if [[ ! -f "$DEV_SESSIONS_FILE" ]]; then
    echo "dev close: no recorded sessions ($DEV_SESSIONS_FILE doesn't exist)." >&2
    return 1
  fi

  # Prune entries whose tab is no longer alive. Echoes the remaining count.
  local remaining
  remaining=$(_dev_prune_sessions)
  if [[ "${remaining:-0}" -eq 0 ]]; then
    echo "dev close: no live dev sessions tracked." >&2
    return 1
  fi

  local target_tab=""

  if [[ "$target" == "." ]]; then
    local current_tab
    current_tab=$(kitty @ ls 2>/dev/null | jq -r '[.[] | .tabs[] | select(.is_focused) | .id][0] // ""')
    if [[ -z "$current_tab" ]]; then
      echo "dev close .: couldn't identify the focused kitty tab." >&2
      return 1
    fi
    if ! jq -e --arg t "$current_tab" 'any(.tab_id == $t)' "$DEV_SESSIONS_FILE" >/dev/null; then
      echo "dev close .: current tab is not a tracked dev session." >&2
      echo "     Use 'dev close' (no arg) to fzf-pick from active sessions." >&2
      return 1
    fi
    target_tab="$current_tab"
  else
    local choice
    choice=$(
      jq -r --arg home "$HOME" \
        '.[] | "\(.tab_id)\t\(.project_path | sub($home; "~"))\t\(.started_at)"' \
        "$DEV_SESSIONS_FILE" \
      | fzf --prompt="Close session: " --with-nth=2.. --delimiter=$'\t' --preview-window=hidden
    )
    if [[ -z "$choice" ]]; then
      return 0
    fi
    target_tab=$(printf '%s' "$choice" | cut -f1)
  fi

  # Pull window IDs for this session.
  local entry nvim_w claude_w shell_w project
  entry=$(jq -r --arg t "$target_tab" '.[] | select(.tab_id == $t)' "$DEV_SESSIONS_FILE")
  nvim_w=$(printf '%s' "$entry" | jq -r '.nvim_win // ""')
  claude_w=$(printf '%s' "$entry" | jq -r '.claude_win // ""')
  shell_w=$(printf '%s' "$entry" | jq -r '.shell_win // ""')
  project=$(printf '%s' "$entry" | jq -r '.project_path // ""')

  # nvim first: :qa will fail if any buffer is modified, surfacing unsaved
  # work without losing it. If nvim is still running in its window after the
  # attempt, abort the rest of the soft-close so the user can resolve.
  # After nvim quits, the kitty window still holds the parent shell — send
  # `exit` so the window closes too.
  if [[ -n "$nvim_w" ]]; then
    kitty @ send-text --match "id:$nvim_w" $'\e:qa\r' > /dev/null 2>&1
    sleep 0.5
    if kitty @ ls 2>/dev/null \
      | jq -e --arg w "$nvim_w" '
          [.[] | .tabs[].windows[] | select((.id | tostring) == $w)
                                   | .foreground_processes[].cmdline[0]
                                   | select(contains("nvim"))] | length > 0
        ' >/dev/null
    then
      echo "dev close: nvim has unsaved changes (or :qa was blocked) in '$project'." >&2
      echo "     Save (:w) or force-quit (:qa!) inside the nvim pane, then re-run dev close." >&2
      return 1
    fi
    kitty @ send-text --match "id:$nvim_w" $'exit\n' > /dev/null 2>&1
  fi

  # Claude: `/exit` ends the session (Ctrl-D is a literal key in Claude's TUI,
  # not EOF). Then `exit` closes the parent shell so the window goes away.
  if [[ -n "$claude_w" ]]; then
    kitty @ send-text --match "id:$claude_w" $'/exit\r' > /dev/null 2>&1
    sleep 1.0
    kitty @ send-text --match "id:$claude_w" $'exit\n' > /dev/null 2>&1
  fi
  # Shell: graceful exit; tab closes when the last process exits.
  if [[ -n "$shell_w" ]]; then
    kitty @ send-text --match "id:$shell_w" $'exit\n' > /dev/null 2>&1
  fi

  # Drop this entry from the state file regardless of whether the windows
  # finish exiting (we'll re-prune on next `dev close`).
  local tmp
  tmp=$(mktemp)
  jq --arg t "$target_tab" 'map(select(.tab_id != $t))' "$DEV_SESSIONS_FILE" >"$tmp" \
    && mv "$tmp" "$DEV_SESSIONS_FILE" || rm -f "$tmp"
}

# ── Layout builder ─────────────────────────────────────────────────────────
# Builds the 3-pane (or 2-pane simple) layout around a given nvim window.
# Args:
#   1: nvim window id (where `nvim` will be invoked)
#   2: project path
#   3: tab id (for session state; "" to skip)
#   4: mode — "default" or "simple"
#   5: defer_claude — 0 = wait for lockfile synchronously, 1 = wait in background
#      (1 is needed for `dev .` because the shell can't start nvim until this
#      script exits, so the lockfile can't appear in the foreground.)
_dev_build_layout() {
  local nvim_win="$1" project="$2" tab_id="$3" mode="$4" defer_claude="$5"

  mkdir -p "$HOME/.claude/ide"
  _dev_prune_dead_lockfiles
  local before
  before=$(_dev_lockfile_snapshot)

  sleep "$DEV_SHELL_READY_WAIT"
  kitty @ send-text --match "id:$nvim_win" "nvim\n" > /dev/null

  if [[ "$mode" == "simple" ]]; then
    local shell_win
    shell_win=$(kitty @ launch --location=vsplit --bias="$DEV_SHELL_BIAS" --cwd="$project")
    [[ -n "$tab_id" ]] && _dev_record_session "$tab_id" "$project" "$nvim_win" "" "$shell_win"
    return 0
  fi

  # Default: (nvim / shell) | claude
  local claude_win
  claude_win=$(kitty @ launch --location=vsplit --bias="$DEV_CLAUDE_BIAS" --cwd="$project")

  if (( defer_claude )); then
    # Background: wait for lockfile, then send claude command. Needed when this
    # script's shell is also the one that will run nvim — we can't observe the
    # lockfile in the foreground because nvim hasn't started yet.
    (
      local matched_lock port claude_cmd="claude --ide"
      matched_lock=$(_dev_wait_for_new_lockfile "$project" "$before")
      if [[ -n "$matched_lock" ]]; then
        port=$(basename "$matched_lock" .lock)
        if [[ "$port" =~ ^[0-9]+$ ]]; then
          claude_cmd="CLAUDE_CODE_SSE_PORT=$port ENABLE_IDE_INTEGRATION=true claude --ide"
        fi
      fi
      sleep "$DEV_SHELL_READY_WAIT"
      kitty @ send-text --match "id:$claude_win" "$claude_cmd"$'\n' > /dev/null
    ) </dev/null >/dev/null 2>&1 &
    disown
  else
    local matched_lock
    matched_lock=$(_dev_wait_for_new_lockfile "$project" "$before")
    local claude_cmd="claude --ide"
    if [[ -n "$matched_lock" ]]; then
      local port
      port=$(basename "$matched_lock" .lock)
      if [[ "$port" =~ ^[0-9]+$ ]]; then
        claude_cmd="CLAUDE_CODE_SSE_PORT=$port ENABLE_IDE_INTEGRATION=true claude --ide"
      fi
    else
      echo "dev: nvim's IDE lockfile didn't appear within ${DEV_LOCKFILE_TIMEOUT}s." >&2
      echo "     Falling back to 'claude --ide' (scans all lockfiles). If it picks" >&2
      echo "     the wrong nvim, run /ide inside Claude and select the right one." >&2
    fi
    sleep "$DEV_SHELL_READY_WAIT"
    kitty @ send-text --match "id:$claude_win" "$claude_cmd"$'\n' > /dev/null
  fi

  kitty @ focus-window --match "id:$nvim_win" > /dev/null
  local shell_win
  shell_win=$(kitty @ launch --location=hsplit --bias="$DEV_SHELL_BIAS" --cwd="$project")

  [[ -n "$tab_id" ]] && _dev_record_session "$tab_id" "$project" "$nvim_win" "$claude_win" "$shell_win"
}

# ── Local mode (`dev .`) ───────────────────────────────────────────────────
_dev_local() {
  _dev_prereq || return 1

  local project="$PWD"
  if [[ "${DEV_ANY_CWD:-0}" != "1" && "$project" != "$HOME/Dev/"* ]]; then
    echo "dev .: refusing to build a session here — cwd is not under ~/Dev." >&2
    echo "     If this is intentional, re-run with DEV_ANY_CWD=1 dev ." >&2
    return 1
  fi

  # The 3-pane layout assumes an empty tab. Refuse if the current tab already
  # has splits — building on top would produce an unpredictable layout.
  if command -v jq >/dev/null 2>&1; then
    local window_count
    window_count=$(kitty @ ls 2>/dev/null | jq -r \
      '[.[] | .tabs[] | select(.is_focused) | (.windows | length)][0] // 0')
    if [[ "${window_count:-0}" -gt 1 ]]; then
      echo "dev .: refusing — the current kitty tab already has $window_count windows." >&2
      echo "     dev . builds an opinionated 3-pane layout and assumes a single window." >&2
      echo "     Open a fresh tab (cmd+t) and try again." >&2
      return 1
    fi
  fi

  local nvim_win tab_id
  nvim_win=$(_dev_current_window_id)
  if [[ -z "$nvim_win" ]]; then
    echo "dev .: couldn't identify the focused kitty window. Is jq installed?" >&2
    return 1
  fi
  tab_id=$(_dev_tab_id_for_window "$nvim_win")

  # Background-deferred claude wait: the current shell is running this script
  # and can't start nvim until we exit, so the lockfile won't appear in time.
  _dev_build_layout "$nvim_win" "$project" "$tab_id" "default" 1
}

# ── Default flow (`dev`, `dev -s`) ─────────────────────────────────────────
_dev_open() {
  _dev_prereq || return 1

  local selected
  selected=$(cd ~/Dev && ls -1 | fzf --prompt="Select project: " --preview-window=hidden)

  if [[ -z $selected ]]; then
    exit 0
  fi

  local tab_name
  tab_name=$(basename "$selected")
  selected="$HOME/Dev/$selected"

  local nvim_win tab_id
  nvim_win=$(kitty @ launch --type=tab --cwd="$selected" --tab-title="$tab_name")
  tab_id=$(_dev_tab_id_for_window "$nvim_win")

  local mode="default"
  [[ "${1:-}" == "-s" ]] && mode="simple"

  # Foreground claude wait: nvim runs in the freshly-launched shell, so the
  # lockfile appears while this script is still running.
  _dev_build_layout "$nvim_win" "$selected" "$tab_id" "$mode" 0
}

# ── Subcommand dispatch ────────────────────────────────────────────────────
case "${1:-}" in
  -h|--help)
    _dev_help
    exit 0
    ;;
  check)
    shift
    _dev_check "$@"
    exit $?
    ;;
  close)
    shift
    _dev_close "$@"
    exit $?
    ;;
  .)
    shift
    _dev_local "$@"
    exit $?
    ;;
  ""|-s)
    _dev_open "$@"
    exit $?
    ;;
  *)
    echo "dev: unknown subcommand: $1" >&2
    echo >&2
    _dev_help >&2
    exit 1
    ;;
esac
