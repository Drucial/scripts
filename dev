#!/usr/bin/env bash
# op - Open Project in Kitty with nvim

# Find directories in ~/Dev and select with fzf
selected=$(cd ~/Dev && ls -1 | fzf --prompt="Select project: " --preview-window=hidden)

# Exit if nothing selected
if [[ -z $selected ]]; then
  exit 0
fi

# Get the directory name for the tab title
tab_name=$(basename "$selected")

# Build full path
selected="$HOME/Dev/$selected"

# Use kitty remote control to create new tab with nvim and split
kitty @ launch --type=tab --cwd="$selected" --tab-title="$tab_name"
sleep 0.1
kitty @ send-text --match recent:0 "nvim\n"
kitty @ launch --location=vsplit --bias=30 --cwd="$selected"
